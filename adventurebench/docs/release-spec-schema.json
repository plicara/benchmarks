{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plicara.ai/schemas/adventurebench/release-spec-1.0.json",
  "title": "Adventure Bench staged collection release specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "repetitions", "smoke_case_ids", "models"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "release_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "repetitions": {"type": "integer", "minimum": 1},
    "smoke_case_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}
    },
    "models": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["model", "provider", "runtime"],
        "properties": {
          "model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"},
          "provider": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$"},
          "runtime": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$"}
        }
      }
    }
  }
}
