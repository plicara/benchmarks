{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plicara.ai/schemas/adventurebench/release-1.0.json",
  "title": "Adventure Bench audited release set",
  "type": "object",
  "required": ["schema_version", "kind", "release_id", "run_ids", "benchmark", "collection_window", "coverage", "models", "tag_matrix", "bootstrap"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "adventure-bench-release-set" },
    "release_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "run_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
    },
    "benchmark": {
      "type": "object",
      "required": ["name", "version", "dataset_sha256", "prompt_sha256"],
      "properties": {
        "name": { "const": "Adventure Bench" },
        "version": { "type": "string" },
        "dataset_sha256": { "$ref": "#/$defs/sha256" },
        "prompt_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "collection_window": { "$ref": "#/$defs/window" },
    "coverage": {
      "type": "object",
      "required": ["case_repetitions", "case_count", "repetitions"],
      "properties": {
        "case_repetitions": { "type": "integer", "minimum": 1 },
        "case_count": { "type": "integer", "minimum": 1 },
        "repetitions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } }
      },
      "additionalProperties": false
    },
    "models": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/model" } },
    "tag_matrix": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "$ref": "#/$defs/score" }
      }
    },
    "bootstrap": { "$ref": "#/$defs/bootstrap" }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "window": {
      "type": "object",
      "required": ["started_at", "completed_at"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "score": {
      "type": "object",
      "required": ["passed", "total", "score"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 },
        "score": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "failures": {
      "type": "object",
      "required": ["transport", "parsing"],
      "properties": {
        "transport": { "type": "integer", "minimum": 0 },
        "parsing": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["manifest_sha256", "responses_sha256", "records"],
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "responses_sha256": { "$ref": "#/$defs/sha256" },
        "records": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["run_id", "model_slug", "overall", "failures", "provenance", "evidence"],
      "properties": {
        "run_id": { "type": "string" },
        "model_slug": { "type": "string" },
        "overall": { "$ref": "#/$defs/score" },
        "failures": { "$ref": "#/$defs/failures" },
        "provenance": { "type": "object" },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "additionalProperties": false
    },
    "interval": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "type": "number", "minimum": -1, "maximum": 1 },
        { "type": "number", "minimum": -1, "maximum": 1 }
      ],
      "items": false
    },
    "bootstrap": {
      "type": "object",
      "required": ["confidence_level", "cluster_unit", "seed", "replicates", "algorithm", "score_intervals", "paired_score_difference_intervals"],
      "properties": {
        "confidence_level": { "const": 0.95 },
        "cluster_unit": { "const": "case_id" },
        "seed": { "type": "integer" },
        "replicates": { "type": "integer", "minimum": 1 },
        "algorithm": { "type": "string" },
        "score_intervals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["model_slug", "estimate", "interval"],
            "properties": {
              "model_slug": { "type": "string" },
              "estimate": { "type": "number", "minimum": 0, "maximum": 1 },
              "interval": { "$ref": "#/$defs/interval" }
            },
            "additionalProperties": false
          }
        },
        "paired_score_difference_intervals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["model_a", "model_b", "estimate", "interval"],
            "properties": {
              "model_a": { "type": "string" },
              "model_b": { "type": "string" },
              "estimate": { "type": "number", "minimum": -1, "maximum": 1 },
              "interval": { "$ref": "#/$defs/interval" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
